#!/bin/bash
# CCRS-2 CLI Wrapper
# Simple, effective Claude Code routing service

set -e

# Script directory (where this script is located)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# CCRS-2 CLI location
CCRS2_CLI="$SCRIPT_DIR/cli.py"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logo
show_logo() {
    echo -e "${BLUE}"
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║              CCRS-2                   ║"
    echo "  ║    Claude Code Routing Service        ║"
    echo -e "  ║           ${GREEN}Simple & Effective${BLUE}           ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo -e "${NC}"
}

# Help text
show_help() {
    show_logo
    echo -e "${GREEN}USAGE:${NC}"
    echo "  ccrs2 <command> [options]"
    echo
    echo -e "${GREEN}COMMANDS:${NC}"
    echo -e "  ${YELLOW}chat${NC} <message>           Send message to Claude"
    echo -e "  ${YELLOW}command${NC} <cmd>            Execute Claude command"
    echo -e "  ${YELLOW}status${NC} <job-id>          Check job status"
    echo -e "  ${YELLOW}health${NC}                   Check service health"
    echo -e "  ${YELLOW}version${NC}                  Show version"
    echo
    echo -e "${GREEN}OPTIONS:${NC}"
    echo "  --wait                   Wait for job completion"
    echo "  --tenant <name>          Set tenant (default: demo)"
    echo "  --timeout <seconds>      Set timeout (default: 300)"
    echo
    echo -e "${GREEN}EXAMPLES:${NC}"
    echo -e "  ${BLUE}# Quick chat with automatic waiting${NC}"
    echo "  ccrs2 chat \"Hello Claude!\" --wait"
    echo
    echo -e "  ${BLUE}# Execute command${NC}"
    echo "  ccrs2 command \"/help\" --wait"
    echo
    echo -e "  ${BLUE}# Check job status${NC}"
    echo "  ccrs2 status ccrs2-abc12345"
    echo
    echo -e "  ${BLUE}# Health check${NC}"
    echo "  ccrs2 health"
    echo
    echo -e "  ${BLUE}# Custom tenant and timeout${NC}"
    echo "  ccrs2 chat \"Analyze this code\" --tenant prod --timeout 600 --wait"
    echo
    echo -e "${GREEN}ENVIRONMENT:${NC}"
    echo "  CCRS2_URL               Override API URL (default: http://localhost:8001)"
    echo "  CCRS2_TENANT            Override default tenant (default: demo)"
    echo
    echo -e "${GREEN}SHORTCUTS:${NC}"
    echo "  ccrs2 -h, --help        Show this help"
    echo "  ccrs2 -v                Show version"
    echo "  ccrs2 up                Start CCRS-2 services (full docker-compose)"
    echo "  ccrs2 up-hybrid         Start hybrid services (API + Redis only)"
    echo "  ccrs2 down              Stop all CCRS-2 services"
    echo "  ccrs2 logs              Show service logs"
    echo "  ccrs2 ps                Show service status"
    echo "  ccrs2 worker-host       Run worker on host (for Claude integration)"
}

# Show version
show_version() {
    echo -e "${GREEN}CCRS-2 CLI Wrapper v2.0.0${NC}"
    echo "Simple, effective Claude Code routing service"
}

# Check if Python CLI exists
check_cli() {
    if [[ ! -f "$CCRS2_CLI" ]]; then
        echo -e "${RED}❌ Error: CCRS-2 CLI not found at $CCRS2_CLI${NC}" >&2
        echo -e "   Make sure you're running from the CCRS-2 directory" >&2
        exit 1
    fi
}

# Check if Python is available
check_python() {
    if ! command -v python3 &> /dev/null && ! command -v python &> /dev/null; then
        echo -e "${RED}❌ Error: Python not found${NC}" >&2
        echo -e "   Please install Python 3.11+ to use CCRS-2" >&2
        exit 1
    fi
}

# Get python command
get_python() {
    if command -v python3 &> /dev/null; then
        echo "python3"
    elif command -v python &> /dev/null; then
        echo "python"
    else
        echo -e "${RED}❌ Error: Python not found${NC}" >&2
        exit 1
    fi
}

# Execute with proper python
run_cli() {
    local python_cmd
    python_cmd=$(get_python)
    "$python_cmd" "$CCRS2_CLI" "$@"
}

# Docker shortcuts
docker_up() {
    echo -e "${GREEN}🚀 Starting CCRS-2 services...${NC}"

    # Check if hybrid mode available
    if [[ -f "docker-compose.hybrid.yml" ]]; then
        echo -e "${BLUE}📋 Detected hybrid deployment option${NC}"
        echo -e "   ${YELLOW}Recommendation: Use hybrid mode for real Claude integration${NC}"
        echo -e "   Full mode: ${BLUE}docker-compose up -d${NC}"
        echo -e "   Hybrid mode: ${BLUE}docker-compose -f docker-compose.hybrid.yml up -d${NC}"
        echo ""
        echo -e "${YELLOW}Starting in FULL mode (includes containerized worker)${NC}"
    fi

    docker-compose up -d
}

docker_up_hybrid() {
    echo -e "${GREEN}🚀 Starting CCRS-2 hybrid services (API + Redis)...${NC}"
    echo -e "${BLUE}📋 Worker will need to run on host for Claude CLI access${NC}"

    if [[ ! -f "docker-compose.hybrid.yml" ]]; then
        echo -e "${RED}❌ Hybrid configuration not found${NC}"
        echo -e "   Please check deployment documentation"
        exit 1
    fi

    docker-compose -f docker-compose.hybrid.yml up -d

    echo ""
    echo -e "${YELLOW}🔧 Next steps for Claude integration:${NC}"
    echo -e "   1. Run worker: ${BLUE}python worker-production.py${NC}"
    echo -e "   2. Or use script: ${BLUE}./run-worker-host.sh${NC}"
    echo -e "   3. Test: ${BLUE}./ccrs2 chat \"Hello Claude!\" --wait${NC}"
}

docker_down() {
    echo -e "${YELLOW}🛑 Stopping CCRS-2 services...${NC}"

    # Stop both configurations if they exist
    if docker-compose ps | grep -q "ccrs2"; then
        docker-compose down
    fi

    if [[ -f "docker-compose.hybrid.yml" ]] && docker-compose -f docker-compose.hybrid.yml ps | grep -q "ccrs2"; then
        docker-compose -f docker-compose.hybrid.yml down
    fi
}

docker_logs() {
    echo -e "${BLUE}📋 CCRS-2 service logs:${NC}"
    docker-compose logs -f
}

docker_ps() {
    echo -e "${BLUE}📊 CCRS-2 service status:${NC}"
    docker-compose ps
}

# Quick status check
quick_status() {
    echo -e "${BLUE}🔍 Quick CCRS-2 Status Check${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Check if services are running
    if docker-compose ps | grep -q "Up"; then
        echo -e "${GREEN}✅ Docker services: Running${NC}"
    else
        echo -e "${RED}❌ Docker services: Not running${NC}"
        echo -e "   Run: ${YELLOW}ccrs2 up${NC}"
        return 1
    fi

    # Check API health
    echo -e "${BLUE}🏥 Checking API health...${NC}"
    run_cli health 2>/dev/null || {
        echo -e "${RED}❌ API health check failed${NC}"
        echo -e "   Try: ${YELLOW}ccrs2 logs${NC}"
        return 1
    }
}

# Main function
main() {
    # Handle no arguments
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    # Handle special flags
    case "$1" in
        -h|--help|help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        version)
            show_version
            echo
            check_cli
            run_cli version
            exit 0
            ;;
        up|start)
            docker_up
            exit 0
            ;;
        up-hybrid|hybrid)
            docker_up_hybrid
            exit 0
            ;;
        down|stop)
            docker_down
            exit 0
            ;;
        logs)
            docker_logs
            exit 0
            ;;
        ps|status-all)
            docker_ps
            exit 0
            ;;
        check|status-check)
            quick_status
            exit 0
            ;;
        worker-host|worker)
            # Run worker on host
            if [[ -f "run-worker-host.sh" ]]; then
                ./run-worker-host.sh
            else
                echo -e "${RED}❌ Worker host script not found${NC}"
                echo -e "   Please run: ${BLUE}python worker-production.py${NC}"
            fi
            exit 0
            ;;
    esac

    # For all other commands, check requirements and forward to Python CLI
    check_python
    check_cli

    # Special handling for common shortcuts
    case "$1" in
        c|chat)
            shift
            run_cli chat "$@"
            ;;
        cmd|command)
            shift
            run_cli command "$@"
            ;;
        s|status)
            shift
            run_cli status "$@"
            ;;
        h|health)
            run_cli health
            ;;
        *)
            # Forward all arguments to Python CLI
            run_cli "$@"
            ;;
    esac
}

# Trap errors
trap 'echo -e "\n${RED}❌ Error occurred. Use ${YELLOW}ccrs2 --help${RED} for usage info.${NC}" >&2' ERR

# Run main function with all arguments
main "$@"