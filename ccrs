#!/bin/bash
# CCRS CLI Wrapper
# Simple, effective Claude Code routing service

set -e

# Script directory (where this script is located)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# CCRS CLI location
CCRS_CLI="$SCRIPT_DIR/cli.py"

# Worker PID file
WORKER_PID_FILE="$SCRIPT_DIR/.worker.pid"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logo
show_logo() {
    echo -e "${BLUE}"
    echo "  ╔═══════════════════════════════════════╗"
    echo "  ║               CCRS                    ║"
    echo "  ║    Claude Code Routing Service        ║"
    echo -e "  ║           ${GREEN}Simple & Effective${BLUE}           ║"
    echo "  ╚═══════════════════════════════════════╝"
    echo -e "${NC}"
}

# Help text
show_help() {
    show_logo
    echo -e "${GREEN}USAGE:${NC}"
    echo "  ccrs <command> [options]"
    echo
    echo -e "${GREEN}COMMANDS:${NC}"
    echo -e "  ${YELLOW}chat${NC} <message>           Send message to Claude"
    echo -e "  ${YELLOW}command${NC} <cmd>            Execute Claude command"
    echo -e "  ${YELLOW}status${NC} <job-id>          Check job status"
    echo -e "  ${YELLOW}health${NC}                   Check service health"
    echo -e "  ${YELLOW}version${NC}                  Show version"
    echo
    echo -e "${GREEN}SERVICE MANAGEMENT:${NC}"
    echo -e "  ${YELLOW}start${NC}                    Start all CCRS services (hybrid mode)"
    echo -e "  ${YELLOW}stop${NC}                     Stop all CCRS services"
    echo -e "  ${YELLOW}restart${NC}                  Restart all services"
    echo -e "  ${YELLOW}status-all${NC}               Show all service status"
    echo
    echo -e "${GREEN}WORKER MANAGEMENT:${NC}"
    echo -e "  ${YELLOW}worker start${NC}             Start worker (foreground)"
    echo -e "  ${YELLOW}worker start -d${NC}          Start worker (background daemon)"
    echo -e "  ${YELLOW}worker stop${NC}              Stop worker daemon"
    echo -e "  ${YELLOW}worker status${NC}            Show worker status"
    echo -e "  ${YELLOW}worker restart${NC}           Restart worker"
    echo
    echo -e "${GREEN}OPTIONS:${NC}"
    echo "  --wait                   Wait for job completion"
    echo "  --tenant <name>          Set tenant (default: demo)"
    echo "  --timeout <seconds>      Set timeout (default: 300)"
    echo "  -d, --daemon             Run worker in background"
    echo
    echo -e "${GREEN}EXAMPLES:${NC}"
    echo -e "  ${BLUE}# Start CCRS (hybrid mode - recommended)${NC}"
    echo "  ccrs start"
    echo
    echo -e "  ${BLUE}# Quick chat with automatic waiting${NC}"
    echo "  ccrs chat \"Hello Claude!\" --wait"
    echo
    echo -e "  ${BLUE}# Execute command${NC}"
    echo "  ccrs command \"/help\" --wait"
    echo
    echo -e "  ${BLUE}# Check job status${NC}"
    echo "  ccrs status ccrs-abc12345"
    echo
    echo -e "  ${BLUE}# Start worker in background${NC}"
    echo "  ccrs worker start --daemon"
    echo
    echo -e "${GREEN}ENVIRONMENT:${NC}"
    echo "  CCRS_URL                 Override API URL (default: http://localhost:8001)"
    echo "  CCRS_TENANT              Override default tenant (default: demo)"
    echo
    echo -e "${GREEN}SHORTCUTS:${NC}"
    echo "  ccrs -h, --help          Show this help"
    echo "  ccrs -v                  Show version"
    echo "  ccrs c \"message\"         Chat shortcut"
    echo "  ccrs s <job-id>          Status shortcut"
    echo "  ccrs logs                View service logs"
    echo "  ccrs ps                  Show container status"
}

# Show version
show_version() {
    echo -e "${GREEN}CCRS CLI Wrapper v3.0.0${NC}"
    echo "Simple, effective Claude Code routing service"
    echo "Hybrid deployment with real Claude CLI integration"
}

# Check if Python CLI exists
check_cli() {
    if [[ ! -f "$CCRS_CLI" ]]; then
        echo -e "${RED}❌ Error: CCRS CLI not found at $CCRS_CLI${NC}" >&2
        echo -e "   Make sure you're running from the CCRS directory" >&2
        exit 1
    fi
}

# Check if Python is available
check_python() {
    if ! command -v python3 &> /dev/null && ! command -v python &> /dev/null; then
        echo -e "${RED}❌ Error: Python not found${NC}" >&2
        echo -e "   Please install Python 3.11+ to use CCRS" >&2
        exit 1
    fi
}

# Get python command
get_python() {
    if command -v python3 &> /dev/null; then
        echo "python3"
    elif command -v python &> /dev/null; then
        echo "python"
    else
        echo -e "${RED}❌ Error: Python not found${NC}" >&2
        exit 1
    fi
}

# Execute with proper python
run_cli() {
    local python_cmd
    python_cmd=$(get_python)
    "$python_cmd" "$CCRS_CLI" "$@"
}

# Start CCRS services (hybrid mode)
start_services() {
    echo -e "${GREEN}🚀 Starting CCRS services (hybrid mode)...${NC}"

    # Start containers (API + Redis)
    if [[ -f "docker-compose.hybrid.yml" ]]; then
        docker-compose -f docker-compose.hybrid.yml up -d
    else
        echo -e "${YELLOW}⚠️  Hybrid config not found, using default docker-compose${NC}"
        docker-compose up -d
    fi

    # Wait for services to be ready
    sleep 3

    echo -e "${GREEN}✅ Containers started${NC}"
    echo -e "${BLUE}🔧 Next step: Start worker with 'ccrs worker start'${NC}"
}

# Stop CCRS services
stop_services() {
    echo -e "${YELLOW}🛑 Stopping CCRS services...${NC}"

    # Stop worker first
    stop_worker_daemon

    # Stop containers
    if [[ -f "docker-compose.hybrid.yml" ]]; then
        docker-compose -f docker-compose.hybrid.yml down
    else
        docker-compose down
    fi

    echo -e "${GREEN}✅ All CCRS services stopped${NC}"
}

# Restart CCRS services
restart_services() {
    echo -e "${BLUE}🔄 Restarting CCRS services...${NC}"
    stop_services
    sleep 2
    start_services
}

# Start worker
start_worker() {
    local daemon_mode=false

    # Check for daemon flag
    if [[ "$1" == "-d" || "$1" == "--daemon" ]]; then
        daemon_mode=true
    fi

    # Check if worker is already running
    if [[ -f "$WORKER_PID_FILE" ]]; then
        local pid=$(cat "$WORKER_PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo -e "${YELLOW}⚠️  Worker already running (PID: $pid)${NC}"
            return 0
        else
            # Clean up stale PID file
            rm -f "$WORKER_PID_FILE"
        fi
    fi

    # Check if containers are running
    if ! docker-compose ps | grep -q "Up"; then
        echo -e "${RED}❌ CCRS containers not running${NC}"
        echo -e "   Start with: ${BLUE}ccrs start${NC}"
        return 1
    fi

    check_python
    local python_cmd=$(get_python)

    if [[ "$daemon_mode" == true ]]; then
        echo -e "${GREEN}🚀 Starting CCRS worker (daemon mode)...${NC}"

        # Start worker in background
        nohup "$python_cmd" -u worker.py > worker.log 2>&1 &
        local worker_pid=$!

        # Save PID
        echo $worker_pid > "$WORKER_PID_FILE"

        # Wait a moment and check if it's still running
        sleep 2
        if ps -p "$worker_pid" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ Worker started (PID: $worker_pid)${NC}"
            echo -e "${BLUE}📋 Log file: worker.log${NC}"
        else
            echo -e "${RED}❌ Worker failed to start${NC}"
            rm -f "$WORKER_PID_FILE"
            return 1
        fi
    else
        echo -e "${GREEN}🚀 Starting CCRS worker (foreground)...${NC}"
        echo -e "${BLUE}📋 Press Ctrl+C to stop${NC}"
        exec "$python_cmd" -u worker.py
    fi
}

# Stop worker daemon
stop_worker_daemon() {
    if [[ -f "$WORKER_PID_FILE" ]]; then
        local pid=$(cat "$WORKER_PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo -e "${YELLOW}🛑 Stopping worker (PID: $pid)...${NC}"
            kill "$pid"

            # Wait for process to stop
            local count=0
            while ps -p "$pid" > /dev/null 2>&1 && [[ $count -lt 10 ]]; do
                sleep 1
                ((count++))
            done

            if ps -p "$pid" > /dev/null 2>&1; then
                echo -e "${RED}⚠️  Force killing worker${NC}"
                kill -9 "$pid"
            fi

            rm -f "$WORKER_PID_FILE"
            echo -e "${GREEN}✅ Worker stopped${NC}"
        else
            echo -e "${YELLOW}⚠️  Worker not running${NC}"
            rm -f "$WORKER_PID_FILE"
        fi
    else
        echo -e "${YELLOW}⚠️  Worker not running (no PID file)${NC}"
    fi
}

# Worker status
worker_status() {
    echo -e "${BLUE}🔍 CCRS Worker Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Check Claude CLI
    if command -v claude &> /dev/null; then
        echo -e "${GREEN}✅ Claude CLI: $(which claude)${NC}"
    else
        echo -e "${RED}❌ Claude CLI: Not found${NC}"
    fi

    # Check worker process
    if [[ -f "$WORKER_PID_FILE" ]]; then
        local pid=$(cat "$WORKER_PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ Worker Process: Running (PID: $pid)${NC}"
        else
            echo -e "${RED}❌ Worker Process: Not running (stale PID)${NC}"
            rm -f "$WORKER_PID_FILE"
        fi
    else
        echo -e "${RED}❌ Worker Process: Not running${NC}"
    fi

    # Check Redis connection
    if nc -z localhost 6380 2>/dev/null; then
        echo -e "${GREEN}✅ Redis Connection: OK (port 6380)${NC}"
    else
        echo -e "${RED}❌ Redis Connection: Failed${NC}"
    fi
}

# Service status
service_status() {
    echo -e "${BLUE}🔍 CCRS Service Status${NC}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Check containers
    if docker-compose ps | grep -q "Up"; then
        echo -e "${GREEN}✅ Containers: Running${NC}"
        docker-compose ps
    else
        echo -e "${RED}❌ Containers: Not running${NC}"
    fi

    echo ""
    worker_status

    # Check API health
    echo ""
    echo -e "${BLUE}🏥 API Health Check...${NC}"
    if run_cli health 2>/dev/null; then
        echo -e "${GREEN}✅ API: Healthy${NC}"
    else
        echo -e "${RED}❌ API: Health check failed${NC}"
    fi
}

# View logs
view_logs() {
    if [[ "$1" == "worker" ]]; then
        if [[ -f "worker.log" ]]; then
            tail -f worker.log
        else
            echo -e "${RED}❌ Worker log file not found${NC}"
        fi
    else
        docker-compose logs -f
    fi
}

# Show container status
show_containers() {
    echo -e "${BLUE}📊 CCRS Container Status${NC}"
    docker-compose ps
}

# Main function
main() {
    # Handle no arguments
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    # Handle special flags
    case "$1" in
        -h|--help|help)
            show_help
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        version)
            show_version
            echo
            check_cli
            run_cli version
            exit 0
            ;;
        start)
            start_services
            exit 0
            ;;
        stop)
            stop_services
            exit 0
            ;;
        restart)
            restart_services
            exit 0
            ;;
        status-all)
            service_status
            exit 0
            ;;
        worker)
            case "$2" in
                start)
                    start_worker "$3"
                    exit 0
                    ;;
                stop)
                    stop_worker_daemon
                    exit 0
                    ;;
                restart)
                    stop_worker_daemon
                    sleep 2
                    start_worker "$3"
                    exit 0
                    ;;
                status)
                    worker_status
                    exit 0
                    ;;
                *)
                    echo -e "${RED}❌ Invalid worker command${NC}"
                    echo "Usage: ccrs worker {start|stop|restart|status} [--daemon]"
                    exit 1
                    ;;
            esac
            ;;
        logs)
            view_logs "$2"
            exit 0
            ;;
        ps)
            show_containers
            exit 0
            ;;
    esac

    # For all other commands, check requirements and forward to Python CLI
    check_python
    check_cli

    # Special handling for common shortcuts
    case "$1" in
        c|chat)
            shift
            run_cli chat "$@"
            ;;
        cmd|command)
            shift
            run_cli command "$@"
            ;;
        s|status)
            shift
            run_cli status "$@"
            ;;
        h|health)
            run_cli health
            ;;
        *)
            # Forward all arguments to Python CLI
            run_cli "$@"
            ;;
    esac
}

# Trap errors
trap 'echo -e "\n${RED}❌ Error occurred. Use ${YELLOW}ccrs --help${RED} for usage info.${NC}" >&2' ERR

# Run main function with all arguments
main "$@"